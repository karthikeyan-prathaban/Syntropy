# ── Setu Account Aggregator ────────────────────────────────────────────────
# Get these from https://bridge.setu.co
# Example: https://bridge.setu.co/v2/product-store/account-aggregator/account-list/<SETU_ORG_ID>/<SETU_PRODUCT_INSTANCE_ID>
SETU_CLIENT_ID=your_client_id_here
SETU_CLIENT_SECRET=your_client_secret_here
SETU_ORG_ID=8890f2ec-f6af-4180-8062-e05f5ae0eb73
SETU_PRODUCT_INSTANCE_ID=796f9c0e-e9d7-437c-8148-9423228909b7

# Sandbox (default) or Production (https://fiu.setu.co)
SETU_FIU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_URL=https://orgservice-prod.setu.co/v1/users/login

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./syntropy.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/syntropy

# ── AI (Optional) ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# If not set, falls back to rule-based financial insights
GEMINI_API_KEY=your_gemini_api_key_here

# ── URLs ───────────────────────────────────────────────────────────────────
# Local Dev:
# FRONTEND_URL=http://localhost:5173
# REDIRECT_URL=http://localhost:5173/consent/callback
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production (Render):
FRONTEND_URL=https://syntropy-k5fj.onrender.com
REDIRECT_URL=https://syntropy-k5fj.onrender.com/consent/callback
CORS_ORIGINS=https://syntropy-k5fj.onrender.com,https://syntropy.onrender.com,http://localhost:5173
