# --- environment ---------------------------------------------------------
# development | production. Production refuses to boot with placeholder
# secrets, demo routes enabled, or SQLite.
ENVIRONMENT=development
ENABLE_DEMO_ROUTES=true
LOG_LEVEL=INFO

# --- secrets -------------------------------------------------------------
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotating ENCRYPTION_KEY makes existing encrypted PII unreadable.
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- data stores ---------------------------------------------------------
# SQLite is development only; production requires PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./novaa.db
REDIS_URL=redis://localhost:6379/0

# --- Setu Account Aggregator ---------------------------------------------
SETU_CLIENT_ID=your_client_id_here
SETU_CLIENT_SECRET=your_client_secret_here
SETU_ORG_ID=8890f2ec-f6af-4180-8062-e05f5ae0eb73
SETU_PRODUCT_INSTANCE_ID=796f9c0e-e9d7-437c-8148-9423228909b7
SETU_FIU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_URL=https://orgservice-prod.setu.co/v1/users/login
SETU_ORG_NAME=NOVAA
# Required before any webhook is processed; unsigned events are rejected.
SETU_WEBHOOK_SECRET=

# --- statement storage ---------------------------------------------------
# local | s3. Local files are encrypted at rest with ENCRYPTION_KEY.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/statements
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- web -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
REDIRECT_URL=http://localhost:5173/consent/callback
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- integrations --------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
SENTRY_DSN=
