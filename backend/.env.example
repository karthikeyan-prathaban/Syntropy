# ── Setu Account Aggregator ────────────────────────────────────────────────
# Get these from https://bridge.setu.co
SETU_CLIENT_ID=your_client_id_here
SETU_CLIENT_SECRET=your_client_secret_here
SETU_ORG_ID=your_org_id_here
SETU_PRODUCT_INSTANCE_ID=your_product_instance_id_here

# Sandbox (default) or Production
SETU_FIU_BASE_URL=https://fiu-sandbox.setu.co
SETU_AUTH_URL=https://orgservice-prod.setu.co/v1/users/login

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./syntropy.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/syntropy

# ── AI (Optional) ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# If not set, falls back to rule-based insights (still great!)
GEMINI_API_KEY=

# ── URLs ───────────────────────────────────────────────────────────────────
# Where the frontend lives (for CORS + redirect URL)
FRONTEND_URL=http://localhost:5173
REDIRECT_URL=http://localhost:5173/consent/callback
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
